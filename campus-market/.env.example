# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Comma-separated list of college email domains allowed to sign in (UI check).
# The real enforcement is the allowed_email_domains table in supabase/schema.sql.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=yourcollege.edu

NEXT_PUBLIC_APP_NAME=CampusMart
NEXT_PUBLIC_CURRENCY=INR
